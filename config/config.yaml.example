# ============================================
# xiaoai-ha-bridge 配置模板
# 使用方式：复制此文件为 config.yaml 后修改
# cp config.yaml.example config.yaml
# ============================================

xiaomi:
  username: 'your_xiaomi_phone'
  password: 'your_xiaomi_password'
  hardware: L06A
  device_did: ''
  tts_reply: true
  cookie_text: ''

homeassistant:
  url: http://your-ha-ip:8123
  token: 'your_ha_long_lived_token'

poll_interval_seconds: 2

# 接管指令时先打断小爱的原生回答（默认 true；关闭后可能与原生回答撞车）
interrupt_native_reply: true

intent_rules: []
ai_mode: true

openai:
  api_base: https://api.deepseek.com
  api_key: 'your_api_key'
  model: deepseek-v4-flash

device_aliases: {}

# 小米账号掉线邮件提醒（可选）
notify:
  email:
    enabled: false
    smtp_host: smtp.qq.com
    smtp_port: 465
    security: ssl          # ssl / starttls / none
    username: you@example.com
    password: 'your_smtp_auth_code'
    from_addr: you@example.com
    to_addrs: you@example.com
    cooldown_minutes: 30

# 配置面板访问保护（可选，HTTP Basic Auth）
web_auth:
  enabled: false
  username: admin
  password: ''

# 设备别名：entity_id -> 别名（可单个字符串，也可列表）
# device_aliases:
#   climate.living_room_ac: 客厅空调
#   fan.living_room: [风扇, 电扇]
